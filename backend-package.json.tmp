{
  "name": "d365-licence-check-backend",
  "version": "3.0.0",
  "description": "D365 Licence Check: Cloud Function for /api and /.auth, Firestore, Cloud Storage",
  "main": "index.js",
  "scripts": {
    "sync": "node scripts/sync.js",
    "prestart": "node scripts/sync.js",
    "start": "node local.js",
    "pretest": "node scripts/sync.js",
    "test": "node test/flow.test.js && node test/invite.test.js",
    "roster": "node scripts/import-roster.js",
    "import-report": "node scripts/import-licensing-report.js",
    "serve": "npm run sync && firebase emulators:start",
    "deploy": "firebase deploy"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "nodemailer": "^6.10.1"
  },
  "private": true,
  "engines": {
    "node": "22"
  }
}
