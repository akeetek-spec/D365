# Copy this file to local.env to change local settings. Everything is optional.
PORT=4280
# Who can sign in to the dashboard (comma-separated email addresses)
ROLE_ITDIRECTOR=pal@akeetek.com
ROLE_ITADMIN=pal@akeetek.com
ROLE_LEADERSHIP=
IT_DIRECTOR_EMAIL=pal@akeetek.com
# outbox = nothing is sent; links appear on the dashboard under "Emails waiting to send"
# gmail  = sent from MAIL_SENDER with a Google App Password (real emails!)
MAIL_MODE=outbox
# MAIL_SENDER=akeetek01@gmail.com
# GMAIL_APP_PASSWORD=
# MAIL_FROM_NAME=D365 Licence Check
LINK_DAYS=30
# Also add the two test people (pal@akeetek.com, akeetek01@gmail.com)
ROSTER_FILE=data/roster.test.json
# Email + password sign-in (Firebase Authentication) instead of the test page
# SIGN_IN=firebase
# FIREBASE_API_KEY=
# Microsoft sign-in instead (optional)
# AAD_TENANT_ID=
# AAD_CLIENT_ID=
# AAD_CLIENT_SECRET=
# SESSION_SECRET=
# Keep data in Firestore instead of .local-data (needs: gcloud auth application-default login)
# STORE=firestore
# GOOGLE_CLOUD_PROJECT=
DATA_FILE=.local-data/test.json