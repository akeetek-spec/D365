rules_version = '2';
// Screenshots are private. Only the app's server (Admin SDK) reads and writes them, and serves them
// through /api/file/<id> after checking who is asking. No direct access from browsers.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
